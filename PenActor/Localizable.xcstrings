    "SwiftUI 双击 / 挤压需 macOS 14.5 或更新；当前仅接入 changeMode 双击。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI 双击 / 挤压需 macOS 14.5 或更新；当前仅接入 changeMode 双击。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftUI double tap and squeeze require macOS 14.5 or later. Only changeMode double taps are available here."
