    "A modified callback does not confirm delivery to the target app. Export a log for analysis.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回调已修改不等于目标应用已确认接收；可导出日志分析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A modified callback does not confirm delivery to the target app. Export a log for analysis."
