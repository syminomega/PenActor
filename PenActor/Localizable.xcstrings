            "value": "Session device ID"
          }
        }
      }
    },
    "使用 Sidecar 时请把此窗口移至 iPad。此区域是输入验证工具；不应用平滑或压力曲线。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Sidecar 时请把此窗口移至 iPad。此区域是输入验证工具；不应用平滑或压力曲线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Sidecar, move this window onto the iPad. This pad tests input without applying smoothing or a pressure curve."
          }
        }
      }
    },
