    "会延迟笔输入，抬笔后修整尚未输出的尾部。快捷键会提前排空缓存。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会延迟笔输入，抬笔后修整尚未输出的尾部。快捷键会提前排空缓存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delays pen input and tapers the queued tail after lift-off. Shortcuts flush the queue early."
          }
        }
      }
    },
    "会话 Device ID": {
      "localizations": {
        "zh-Hans": {
