    "先调整这台设备的默认笔压，再为配置添加生效应用；需要时才单独覆盖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先调整这台设备的默认笔压，再为配置添加生效应用；需要时才单独覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set this device’s pressure defaults, then add target apps to a profile. Override settings only when needed."
          }
        }
      }
    },
