    "Configuration migration did not finish. Saving and mapping are blocked. Check the original files and Backups: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置迁移未完成，已停止配置写入和映射，请检查原文件及 Backups：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration migration did not finish. Saving and mapping are blocked. Check the original files and Backups: %@"
          }
        }
      },
      "comment": " Preserve the format specifier types and argument order."
    },
    "Configure each device separately. Apps in a profile inherit that device’s defaults.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备独立设置，配置中的应用默认继承所属设备。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure each device separately. Apps in a profile inherit that device’s defaults."
          }
        }
      }
    },
    "Connect Sidecar or a tablet, bring the pen into range, and draw. Saved devices remain in the sidebar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Sidecar 或数位板，让笔进入感应范围并落笔。保存过的设备会一直显示在左侧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Sidecar or a tablet, bring the pen into range, and draw. Saved devices remain in the sidebar."
          }
        }
      }
    },
