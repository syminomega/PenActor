    "Enable one profile per device; devices work independently. Saved settings apply from the next stroke. Disabling or pausing stops changes immediately. Bring the pen back into range after first enabling.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备同时启用一个配置，各设备互不影响。保存从下一笔生效；禁用或暂停立即停止修改。首次启用后请让笔重新进入感应范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable one profile per device; devices work independently. Saved settings apply from the next stroke. Disabling or pausing stops changes immediately. Bring the pen back into range after first enabling."
          }
        }
      }
    },
