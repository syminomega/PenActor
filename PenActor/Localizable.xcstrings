    "PenActor 在菜单栏持续运行，关闭设置窗口后仍会处理已启用的笔输入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PenActor 在菜单栏持续运行，关闭设置窗口后仍会处理已启用的笔输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PenActor runs in the menu bar and keeps processing enabled pen input after settings close."
