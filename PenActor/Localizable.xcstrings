    "Double-click to add a point; drag to adjust. Input is horizontal, output vertical. Endpoints are fixed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击添加控制点，拖动调整。横轴输入，纵轴输出；端点固定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click to add a point; drag to adjust. Input is horizontal, output vertical. Endpoints are fixed."
          }
        }
      }
    },
