    "Mapping starts paused after a restart. Enable a profile manually. Use the menu bar to open settings, pause mapping, or quit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启程序后映射默认关闭，需手动启用硬件配置。可从菜单栏随时打开设置、暂停映射或退出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapping starts paused after a restart. Enable a profile manually. Use the menu bar to open settings, pause mapping, or quit."
          }
        }
      }
    },
