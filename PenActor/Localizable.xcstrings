    "保存点击导出时的全部设备最近 500 条事件快照；包含设备标识和应用上下文。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存点击导出时的全部设备最近 500 条事件快照；包含设备标识和应用上下文。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a snapshot of the latest 500 events across all devices, captured when Export was clicked. Includes device IDs and app context."
          }
        }
      }
    },
